<div class="thw-roster-body">
  {{#if empty}}
    <p class="empty">{{localize "THW.Roster.noFolders"}}</p>
  {{else}}
  <div class="bar">
    <label>
      <span>{{localize "THW.Roster.league"}}</span>
      <select name="folder">
        {{#each folders}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
      </select>
    </label>
    <div class="slots {{#if over}}over{{/if}}">
      {{used}} / {{total}} {{localize "THW.Roster.slots"}}
    </div>
  </div>
  <div class="slotbar {{#if over}}over{{/if}}"><i style="width:{{pct}}%"></i></div>
  {{#if over}}<p class="warn">{{localize "THW.Roster.over"}}</p>{{/if}}

  <div class="thw-scroll">
    {{#if members.length}}
    <ol class="members">
      {{#each members}}
      <li class="member" data-actor-id="{{id}}">
        <img src="{{img}}" alt="">
        <div class="txt">
          <b>{{name}}</b>
          <small>{{role}}</small>
        </div>
        <span class="stat">REP {{rep}}</span>
        <span class="stat">AC {{ac}}</span>
        <span class="cost">{{cost}}</span>
        <button type="button" class="mini" data-action="openActor"><i class="fa-solid fa-up-right-from-square"></i></button>
        <button type="button" class="mini danger" data-action="removeActor" data-tooltip="{{localize 'THW.Roster.remove'}}"><i class="fa-solid fa-xmark"></i></button>
      </li>
      {{/each}}
    </ol>
    {{else}}
    <p class="empty">{{localize "THW.Roster.emptyFolder"}}</p>
    {{/if}}
  </div>
  {{/if}}
</div>
