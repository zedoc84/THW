<div class="thw-lists-body thw-scroll">
  <p class="hint">{{localize "THW.Settings.listsHint"}}</p>
  {{#each lists}}
  <fieldset class="thw-list" data-key="{{key}}">
    <legend>{{label}}</legend>
    {{#if values.length}}
    <div class="chips">
      {{#each values as |v|}}
      <span class="chip">{{v}}
        <button type="button" data-action="removeValue" data-key="{{../key}}" data-value="{{v}}" aria-label="{{v}}">&times;</button>
      </span>
      {{/each}}
    </div>
    {{else}}
    <p class="empty">{{localize "THW.Settings.emptyList"}}</p>
    {{/if}}
    <div class="add">
      <input type="text" data-add="{{key}}" maxlength="40" placeholder="{{localize 'THW.Settings.addPlaceholder'}}">
      <button type="button" data-action="addValue" data-key="{{key}}">{{localize "THW.Settings.add"}}</button>
    </div>
  </fieldset>
  {{/each}}
</div>
