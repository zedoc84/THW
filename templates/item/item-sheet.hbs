<div class="thw-sheet thw-item-sheet">
  <header class="thw-head">
    <div class="portrait-wrap small">
      <img class="portrait small" src="{{document.img}}" alt="{{document.name}}"
           data-action="editImage" data-edit="img"
           data-tooltip="{{localize 'THW.Image.tip'}}">
      {{#if editable}}
      <button type="button" class="img-reset" data-action="resetImage" data-edit="img"
              data-tooltip="{{localize 'THW.Image.reset'}}"><i class="fa-solid fa-rotate-left"></i></button>
      {{/if}}
    </div>
    <div class="ident">
      <input class="name" type="text" name="name" value="{{document.name}}" placeholder="{{localize 'THW.Item.namePlaceholder'}}">
      <input class="sub" type="text" name="system.summary" value="{{system.summary}}" maxlength="90" placeholder="{{localize 'THW.Item.summaryPlaceholder'}}">
    </div>
  </header>
  <div class="block">
    <div class="field">
      <label for="thw-qty">{{localize "THW.Item.quantity"}}</label>
      <input id="thw-qty" type="number" name="system.quantity" value="{{system.quantity}}" min="0">
      <label class="checkbox">
        <input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}}>
        {{localize "THW.Item.equipped"}}
      </label>
    </div>
    <label class="field">
      <span>{{localize "THW.Attribute.source"}}</span>
      <input type="text" name="system.source" value="{{system.source}}" placeholder="{{localize 'THW.Attribute.sourcePlaceholder'}}">
    </label>
    <prose-mirror name="system.description" value="{{system.description}}"{{#unless editable}} disabled{{/unless}}></prose-mirror>
  </div>
</div>
