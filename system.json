{
  "id": "thw",
  "title": "THW — Sheet and Dice",
  "description": "Standalone system for Two Hour Wargames games: REP, PEP, SAV, Race/Profession, Class, Weapon, AC and Attributes. No rules text included — Attributes are created as Items and drop-down lists are filled from the world settings.",
  "version": "1.5.2",
  "compatibility": {
    "minimum": "14",
    "verified": "14.364"
  },
  "authors": [
    {
      "name": "Paul",
      "url": "https://github.com/zedoc84/THW/thw-foundry"
    }
  ],
  "esmodules": [
    "module/thw.mjs"
  ],
  "styles": [
    "styles/thw.css"
  ],
  "languages": [
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": [
          "notes"
        ]
      }
    },
    "Item": {
      "attribute": {
        "htmlFields": [
          "description"
        ]
      },
      "item": {
        "htmlFields": [
          "description"
        ]
      }
    }
  },
  "grid": {
    "distance": 1,
    "units": "\""
  },
  "primaryTokenAttribute": "",
  "url": "https://github.com/zedoc84/THW/thw-foundry",
  "manifest": "https://github.com/zedoc84/THW/thw-foundry/releases/latest/download/system.json",
  "download": "https://github.com/zedoc84/THW/thw-foundry/releases/download/v1.5.2/thw.zip",
  "readme": "https://github.com/zedoc84/THW/thw-foundry/blob/main/README.md",
  "changelog": "https://github.com/zedoc84/THW/thw-foundry/blob/main/CHANGELOG.md",
  "bugs": "https://github.com/zedoc84/THW/thw-foundry/issues",
  "license": "LICENSE",
  "flags": {
    "allowBugReporter": true
  }
}
