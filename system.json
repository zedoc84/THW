{
  "id": "thw-unofficial",
  "title": "THW — sheet",
  "description": "Standalone system for Two Hour Wargames games: REP, PEP, SAV, Race/Profession, Class, Weapon, AC and Attributes. No rules text included — Attributes are created as Items and drop-down lists are filled from the world settings.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14.364"
  },
  "authors": [
    {
      "name": "Paul"
    }
  ],
  "esmodules": [
    "module/thw.mjs"
  ],
  "styles": [
    "styles/thw.css"
  ],
  "languages": [
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": [
          "notes"
        ]
      }
    },
    "Item": {
      "attribute": {
        "htmlFields": [
          "description"
        ]
      },
      "item": {
        "htmlFields": [
          "description"
        ]
      }
    }
  },
  "grid": {
    "distance": 1,
    "units": "\""
  },
  "primaryTokenAttribute": "",
  "license": "LICENSE",
  "url": "https://github.com/zedoc84/thw",
  "manifest": "https://raw.githubusercontent.com/zedoc84/THW/main/system.json",
  "download": "https://github.com/zedoc84/THW/releases/download/v1.0.0/thw.zip"
}
