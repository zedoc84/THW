<div class="thw-sheet">

  <header class="thw-head">
    <div class="portrait-wrap">
      <img class="portrait" src="{{document.img}}" alt="{{document.name}}"
           data-action="editImage" data-edit="img"
           data-tooltip="{{localize 'THW.Image.tip'}}">
      {{#if editable}}
      <button type="button" class="img-reset" data-action="resetImage" data-edit="img"
              data-tooltip="{{localize 'THW.Image.reset'}}"><i class="fa-solid fa-rotate-left"></i></button>
      {{/if}}
    </div>
    <div class="ident">
      <input class="name" type="text" name="name" value="{{document.name}}" placeholder="{{localize 'THW.namePlaceholder'}}">
      <div class="line">
        <label class="hash">
          <span>#</span>
          <input type="text" name="system.idNumber" value="{{system.idNumber}}" maxlength="10" placeholder="—">
        </label>
        <label class="role">
          <span>{{localize "THW.Field.role"}}</span>
          <select name="system.role">
            {{#each roleOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
      </div>
    </div>
  </header>

  <div class="thw-scroll">

    <section class="grid-2">
      <div class="block">
        <h3>{{localize "THW.Section.stats"}}</h3>
        {{#each stats}}
        <div class="stat">
          <label for="thw-{{key}}">{{label}}</label>
          <input id="thw-{{key}}" type="number" name="system.{{key}}" value="{{value}}" min="0" max="12">
          <button type="button" class="roll" data-action="rollStat" data-stat="{{key}}"
                  data-tooltip="{{localize 'THW.Roll.tip'}}"><i class="fa-solid fa-dice-d6"></i></button>
        </div>
        {{/each}}
        <div class="stat ac">
          <label for="thw-ac">AC</label>
          <select id="thw-ac" name="system.ac">
            {{#each acOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <span class="note">{{localize "THW.Field.acHint"}}</span>
        </div>
      </div>

      <div class="block">
        <h3>{{localize "THW.Section.profile"}}</h3>
        <div class="field">
          <label for="thw-race">{{localize "THW.Field.race"}}</label>
          <select id="thw-race" name="system.race">
            {{#each raceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          {{#if isGM}}
          <button type="button" class="mini add-list" data-action="addListValue"
                  data-list="races" data-field="race" data-label="{{localize "THW.Field.race"}}"
                  data-tooltip="{{localize "THW.List.addTip"}}"><i class="fa-solid fa-plus"></i></button>
          {{/if}}
        </div>
        <div class="field">
          <label for="thw-cls">{{localize "THW.Field.cls"}}</label>
          <select id="thw-cls" name="system.cls">
            {{#each clsOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          {{#if isGM}}
          <button type="button" class="mini add-list" data-action="addListValue"
                  data-list="classes" data-field="cls" data-label="{{localize "THW.Field.cls"}}"
                  data-tooltip="{{localize "THW.List.addTip"}}"><i class="fa-solid fa-plus"></i></button>
          {{/if}}
        </div>
        <div class="field">
          <label for="thw-weapon">{{localize "THW.Field.weapon"}}</label>
          <select id="thw-weapon" name="system.weapon">
            {{#each weaponOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          {{#if isGM}}
          <button type="button" class="mini add-list" data-action="addListValue"
                  data-list="weapons" data-field="weapon" data-label="{{localize "THW.Field.weapon"}}"
                  data-tooltip="{{localize "THW.List.addTip"}}"><i class="fa-solid fa-plus"></i></button>
          {{/if}}
        </div>
        {{#if isGM}}
        <button type="button" class="mini wide" data-action="openLists">
          <i class="fa-solid fa-list"></i> {{localize "THW.Settings.listsButton"}}
        </button>
        {{else}}
        <p class="hint">{{localize "THW.List.gmOnly"}}</p>
        {{/if}}
      </div>
    </section>

    <section class="block">
      <h3>
        {{localize "THW.Section.attributes"}}
        <button type="button" class="mini" data-action="createEmbedded" data-type="attribute"><i class="fa-solid fa-plus"></i> {{localize "THW.Attribute.add"}}</button>
      </h3>
      {{#if attributes.length}}
      <ol class="attr-list">
        {{#each attributes}}
        <li class="attr" data-item-id="{{id}}">
          <img src="{{img}}" alt="">
          <div class="txt">
            <b>{{name}}{{#if system.equipped}} <i class="fa-solid fa-circle-check equipped" data-tooltip="{{localize 'THW.Item.equipped'}}"></i>{{/if}}</b>
            {{#if system.summary}}<small>{{system.summary}}</small>{{/if}}
          </div>
          <div class="acts">
            <button type="button" class="mini" data-action="postEmbedded" data-tooltip="{{localize 'THW.Embedded.post'}}"><i class="fa-solid fa-comment"></i></button>
            <button type="button" class="mini" data-action="editEmbedded" data-tooltip="{{localize 'THW.Embedded.edit'}}"><i class="fa-solid fa-pen"></i></button>
            <button type="button" class="mini danger" data-action="deleteEmbedded" data-tooltip="{{localize 'THW.Embedded.delete'}}"><i class="fa-solid fa-trash"></i></button>
          </div>
        </li>
        {{/each}}
      </ol>
      {{else}}
      <p class="empty">{{localize "THW.Attribute.none"}}</p>
      {{/if}}
    </section>

    <section class="block">
      <h3>
        {{localize "THW.Section.items"}}
        <button type="button" class="mini" data-action="createEmbedded" data-type="item"><i class="fa-solid fa-plus"></i> {{localize "THW.Item.add"}}</button>
      </h3>
      {{#if gear.length}}
      <ol class="attr-list">
        {{#each gear}}
        <li class="attr" data-item-id="{{id}}">
          <img src="{{img}}" alt="">
          <div class="txt">
            <b>{{name}}{{#if system.equipped}} <i class="fa-solid fa-circle-check equipped" data-tooltip="{{localize 'THW.Item.equipped'}}"></i>{{/if}}</b>
            {{#if system.summary}}<small>{{system.summary}}</small>{{/if}}
          </div>
          <span class="qty" data-tooltip="{{localize 'THW.Item.quantity'}}">&times;{{system.quantity}}</span>
          <div class="acts">
            <button type="button" class="mini" data-action="postEmbedded" data-tooltip="{{localize 'THW.Embedded.post'}}"><i class="fa-solid fa-comment"></i></button>
            <button type="button" class="mini" data-action="editEmbedded" data-tooltip="{{localize 'THW.Embedded.edit'}}"><i class="fa-solid fa-pen"></i></button>
            <button type="button" class="mini danger" data-action="deleteEmbedded" data-tooltip="{{localize 'THW.Embedded.delete'}}"><i class="fa-solid fa-trash"></i></button>
          </div>
        </li>
        {{/each}}
      </ol>
      {{else}}
      <p class="empty">{{localize "THW.Item.none"}}</p>
      {{/if}}
    </section>

    <section class="block notes">
      <h3>{{localize "THW.Section.notes"}}</h3>
      <label class="quote">
        <span>{{localize "THW.Field.quote"}}</span>
        <input type="text" name="system.quote" value="{{system.quote}}" maxlength="120" placeholder="—">
      </label>
      <prose-mirror name="system.notes" value="{{notesHTML}}"{{#unless editable}} disabled{{/unless}}></prose-mirror>
    </section>

  </div>
</div>
